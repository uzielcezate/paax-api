# paax-api environment variables
# Copy this file to .env for local development.
# Never commit .env to version control.

# ── YTMusic OAuth ─────────────────────────────────────────────────────────────
# Production: paste the full contents of your oauth.json here.
# Local dev: leave blank and place oauth.json in the project root instead.
YTMUSIC_OAUTH_JSON=

# ── Redis (optional, for response caching) ────────────────────────────────────
# Set by Railway when you provision a Redis plugin.
# Leave blank to run without caching (slower but functional).
REDIS_URL=

# ── CORS (production origins) ─────────────────────────────────────────────────
# Comma-separated list of allowed production frontend URLs.
# LAN / localhost origins are always allowed in all environments.
# Example: FRONTEND_ORIGINS=https://paax.vercel.app,https://app.paax.io
FRONTEND_ORIGINS=
