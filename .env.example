# paax-api environment variables
# Copy this file to .env for local development.
# Never commit .env to version control.

# ── YTMusic OAuth ─────────────────────────────────────────────────────────────
# Production: paste the full contents of your oauth.json here.
# Local dev: leave blank and place oauth.json in the project root instead.
YTMUSIC_OAUTH_JSON=

# ── Redis (optional, for response caching, locks, rate limiting) ───────────────
# Set by Railway when you provision a Redis plugin.
# Leave blank to run without caching (slower but functional).
REDIS_URL=

# ── CORS (production origins) ─────────────────────────────────────────────────
# Comma-separated list of allowed production frontend URLs.
# LAN / localhost origins are always allowed in all environments.
# Production value for the portfolio demo (docs/features/demo-mode.md):
#   FRONTEND_ORIGINS=https://paaxmusic.app,https://demo.paaxmusic.app,https://uzielsandoval.com,https://www.uzielsandoval.com
FRONTEND_ORIGINS=
# Optional origin PATTERN for hosts that cannot be enumerated (Cloudflare Pages previews).
# Example: FRONTEND_ORIGIN_REGEX=https://[a-z0-9-]+\.paax-demo\.pages\.dev
FRONTEND_ORIGIN_REGEX=

# ── Portfolio demo sessions (docs/features/demo-mode.md) ──────────────────────
# PUBLIC Supabase API key (the same kind of value the Flutter app ships with) —
# used only for the GoTrue password grant that turns a freshly minted demo
# identity into a session. Not a secret, but the SERVICE ROLE key below stays
# strictly server-side and sb_secret_ keys are rejected here.
# Preferred: modern publishable key (sb_publishable_...). Opaque string, not a JWT.
SUPABASE_PUBLISHABLE_KEY=
# Legacy fallback, used only when SUPABASE_PUBLISHABLE_KEY is empty.
SUPABASE_ANON_KEY=
# Off by default. Deploy with false first; set true only after the Supabase
# migration is applied and the demo origin checks pass (see docs/features/demo-mode.md).
DEMO_ENABLED=false
DEMO_SESSION_SECONDS=600
DEMO_RATE_LIMIT_PER_IP=6
DEMO_RATE_LIMIT_WINDOW_SECONDS=600
DEMO_RATE_LIMIT_GLOBAL=120
# Fail closed: when Redis is missing/unreachable the per-IP and global limits
# cannot be enforced, so POST /v2/demo/sessions answers 503 DEMO_UNAVAILABLE
# instead of minting identities unlimited. Leave true in production.
DEMO_REQUIRE_RATE_LIMITER=true
DEMO_WEB_URL=https://demo.paaxmusic.app/?demo=1

# ══════════════════════════════════════════════════════════════════════════════
# Phase 2 — Supabase-first catalog backend
# ══════════════════════════════════════════════════════════════════════════════

# ── Supabase (persistent catalog) — SERVICE ROLE, BACKEND ONLY ────────────────
# The service-role key bypasses RLS. It must NEVER ship to Flutter or appear in
# logs/responses. In production both of these are required (fail-fast at startup).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_IMAGES_BUCKET=music-images

# Set to false to boot the legacy (Deezer-live) endpoints without Supabase.
SUPABASE_ENABLED=true

# ── Deezer ────────────────────────────────────────────────────────────────────
DEEZER_BASE_URL=https://api.deezer.com
DEEZER_TIMEOUT_SECONDS=15

# ── Redis response-cache TTLs (seconds) ───────────────────────────────────────
CATALOG_ARTIST_TTL_SECONDS=86400
CATALOG_ALBUM_TTL_SECONDS=86400
CATALOG_TRACK_TTL_SECONDS=86400
CATALOG_DISCOGRAPHY_TTL_SECONDS=21600
SEARCH_CACHE_TTL_SECONDS=1800
HOME_CACHE_TTL_SECONDS=7200
YOUTUBE_MATCH_TTL_SECONDS=1209600
NEGATIVE_CACHE_TTL_SECONDS=300
INGEST_LOCK_TTL_SECONDS=30
REFRESH_LOCK_TTL_SECONDS=30
INGEST_LOCK_WAIT_SECONDS=8

# ── Supabase persistent-catalog freshness windows (seconds) ───────────────────
ARTIST_FRESHNESS_SECONDS=604800
ALBUM_FRESHNESS_SECONDS=2592000
TRACK_FRESHNESS_SECONDS=2592000

# ── Concurrency & artwork limits ──────────────────────────────────────────────
MAX_DEEZER_CONCURRENCY=5
MAX_YOUTUBE_MATCH_CONCURRENCY=3
ARTWORK_CACHING_ENABLED=true
ARTWORK_MAX_BYTES=5242880
ARTWORK_DOWNLOAD_TIMEOUT_SECONDS=10
